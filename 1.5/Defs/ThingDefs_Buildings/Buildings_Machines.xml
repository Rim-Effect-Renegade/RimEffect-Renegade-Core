<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef>
		<defName>RE_Mechanoids_FENRISBase</defName>
		<label>fenris spawner</label>
		<description>Creates a fenris mech.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Alpha</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>550</WorkToMake>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>0.1</Flammability>
		</statBases>
		<comps>
			<li Class="TabulaRasa.CompProperties_PawnSpawner">
				<pawnKind>RE_Mechanoids_FENRIS</pawnKind>
				<newborn>true</newborn>
			</li>
		</comps>
		<size>(1,1)</size>
		<category>Building</category>
		<pathCost>200</pathCost>
		<passability>Standable</passability>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<filthLeaving>Filth_RubbleRock</filthLeaving>
		<hasInteractionCell>false</hasInteractionCell>
		<drawerType>MapMeshAndRealTime</drawerType>
		<altitudeLayer>Building</altitudeLayer>
		<repairEffect>Repair</repairEffect>
		<useHitPoints>True</useHitPoints>
		<selectable>true</selectable>
		<surfaceType>Item</surfaceType>
		<tickerType>Normal</tickerType>
	</ThingDef>

	<RecipeDef>
		<defName>RE_Make_FENRISMech</defName>
		<label>make fenris mech</label>
		<description>Make a fenris mech.</description>
		<jobString>Making fenris mech.</jobString>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>1000</workAmount>
		<unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>45</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>RE_PrefabComponent</li>
					</thingDefs>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentSpacer</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Plasteel</li>
				<li>RE_PrefabComponent</li>
				<li>ComponentSpacer</li>
			</thingDefs>
		</fixedIngredientFilter>
		<recipeUsers>
			<li>RE_ManufacturingBench</li>
		</recipeUsers>
		<products>
			<RE_Mechanoids_FENRISBase>1</RE_Mechanoids_FENRISBase>
		</products>
		<skillRequirements>
			<Crafting>6</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
	</RecipeDef>

